{
  "name": "adminsite-frontend",
  "private": true,
  "description": "Builds the CSS and vendors the JS that ship inside the adminsite wheel.",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ../src/adminsite/static/adminsite.css --minify",
    "watch": "tailwindcss -i ./input.css -o ../src/adminsite/static/adminsite.css --watch",
    "vendor": "node vendor.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.4",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "daisyui": "^5.7.42"
  }
}
